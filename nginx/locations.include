# Additional location blocks for AS-Demo
# This file is included by demo.conf

# Health check (public). Uses the $qm variable + resolver from the including
# server block so a recreated queue-manager is re-resolved (no stale-IP 502).
location /health {
    rewrite ^/health$ /api/health break;
    proxy_pass http://$qm:3000$uri$is_args$args;
}

# Robots.txt
location /robots.txt {
    return 200 "User-agent: *\nDisallow: /api/\nDisallow: /terminal\nDisallow: /grafana/\n";
    add_header Content-Type text/plain;
}
